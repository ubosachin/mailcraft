# ==============================================================================
# MailCraft Production Environment Template (.env.production.example)
# Configure these variables in your Vercel, Railway, or Render dashboard.
# NEVER commit the filled version of this file.
# ==============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://web-tawny-three-j5f5132mxd.vercel.app
API_BASE_URL=https://web-tawny-three-j5f5132mxd.vercel.app/api/v1

# Security Secrets (Generate using: openssl rand -hex 32)
APP_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_64_CHAR_HEX_STRING_FOR_AES_256_GCM
ENCRYPTION_KEY_VERSION=1

# MongoDB Atlas Production Replica Set (with TLS and network allowlist)
MONGODB_URI="mongodb+srv://<app_user>:<password>@cluster0.yourdomain.mongodb.net/mailcraft?retryWrites=true&w=majority"
MONGODB_MAX_POOL_SIZE=25

# Production Redis (Redis Cloud / Upstash / Railway Redis with TLS)
REDIS_URL=rediss://default:<password>@<redis-host>:6379

# Google OAuth (Add both .../api/v1/connections/gmail/callback and .../api/v1/auth/google/callback in Google Cloud Console)
GOOGLE_CLIENT_ID=your_prod_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_prod_google_secret
GOOGLE_REDIRECT_URI=https://web-tawny-three-j5f5132mxd.vercel.app/api/v1/connections/gmail/callback

# Platform Brevo Key (Optional: only for pre-connection OTP verification emails)
SYSTEM_BREVO_API_KEY=
SYSTEM_SENDER_EMAIL=
BREVO_WEBHOOK_SECRET=

# Amazon SES (Production IAM User with ses:SendRawEmail and ses:GetSendQuota permissions only)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_PROD_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=your_prod_aws_secret_key

# Cloudinary Media Storage (Campaign Images)
CLOUDINARY_CLOUD_NAME=your_prod_cloud_name
CLOUDINARY_API_KEY=your_prod_cloudinary_key
CLOUDINARY_API_SECRET=your_prod_cloudinary_secret

# Sentry Production Monitoring
SENTRY_DSN=https://your_sentry_key@o000000.ingest.sentry.io/0000000

