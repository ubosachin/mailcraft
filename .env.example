# ==============================================================================
# MailCraft Environment Configuration Template (.env.example)
# Copy to .env.local for local development. Never commit live secrets to git.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1

# Security & Cryptographic Vault (Mandatory)
# APP_SECRET must be at least 32 characters
APP_SECRET=mailcraft_super_secret_app_key_32bytes_change_in_prod
# ENCRYPTION_KEY must be exactly 64 hex characters (32 bytes AES-256 key)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=1

# Database (MongoDB Atlas or Local Replica Set)
MONGODB_URI=mongodb://127.0.0.1:27017/mailcraft
MONGODB_MAX_POOL_SIZE=10

# Message Queue & Cache (Redis / Upstash)
REDIS_URL=redis://127.0.0.1:6379

# Google OAuth 2.0 (Gmail API Personal Sending)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/connections/gmail/callback

# Brevo v3 Transactional & Promotional Email (Bulk Sending)
BREVO_API_KEY=

# Amazon SES (Bulk Sending via SigV4)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary Media Storage (Campaign Images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry Application Performance & Error Monitoring
SENTRY_DSN=
